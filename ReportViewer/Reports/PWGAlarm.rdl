  <DataSources>
    <DataSource Name="DataSource1">
      <rd:SecurityType>DataBase</rd:SecurityType>
      <ConnectionProperties>
        <DataProvider>SQL</DataProvider>
        <ConnectString>Data Source=.\SQLEXPRESS;Initial Catalog=PR_474</ConnectString>
      </ConnectionProperties>
      <rd:DataSourceID>8af434fd-be1c-423e-8477-d8c6a6899273</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>DataSource1</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@StartTime">
            <Value>=Parameters!StartTime.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@EndTime">
            <Value>=Parameters!EndTime.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT DATEADD(n, 330, Al_Norm_Time) AS NormTime, DATEADD(n, 330, Al_Ack_Time) AS AckTime, DATEADD(n, 330, Al_Event_Time) AS EventTime, Al_User, Al_User_Comment, Al_Group, Al_Message
FROM     ALARMHISTORY
WHERE  (DATEADD(n, 330, Al_Event_Time) &gt;= @StartTime) AND (DATEADD(n, 330, Al_Event_Time) &lt;= @EndTime) AND (Al_Group = 4)
ORDER BY EventTime</CommandText>
      </Query>
      <Fields>
        <Field Name="NormTime">
          <rd:TypeName>System.DateTime</rd:TypeName>
          <DataField>NormTime</DataField>
        </Field>
        <Field Name="AckTime">
          <rd:TypeName>System.DateTime</rd:TypeName>
          <DataField>AckTime</DataField>
        </Field>
        <Field Name="EventTime">
          <rd:TypeName>System.DateTime</rd:TypeName>
          <DataField>EventTime</DataField>
        </Field>
        <Field Name="Al_User">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>Al_User</DataField>
        </Field>
        <Field Name="Al_User_Comment">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>Al_User_Comment</DataField>
        </Field>
        <Field Name="Al_Group">
          <rd:TypeName>System.Int32</rd:TypeName>
          <DataField>Al_Group</DataField>
        </Field>
        <Field Name="Al_Message">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>Al_Message</DataField>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="DataSet2">
      <Query>
        <DataSourceName>DataSource1</DataSourceName>
        <rd:DesignerState>
          <QueryDefinition xmlns="http://schemas.microsoft.com/ReportingServices/QueryDefinition/Relational">
            <SelectedColumns>
              <ColumnExpression ColumnOwner="report_login_status" ColumnName="Id" />
              <ColumnExpression ColumnOwner="report_login_status" ColumnName="Username" />
              <ColumnExpression ColumnOwner="report_login_status" ColumnName="LoginToken" />
              <ColumnExpression ColumnOwner="report_login_status" ColumnName="MachineName" />
              <ColumnExpression ColumnOwner="report_login_status" ColumnName="IpAddress" />
              <ColumnExpression ColumnOwner="report_login_status" ColumnName="LoggedInAt" />
            </SelectedColumns>
          </QueryDefinition>
        </rd:DesignerState>
        <CommandText>SELECT
  report_login_status.Id
  ,report_login_status.Username
  ,report_login_status.LoginToken
  ,report_login_status.MachineName
  ,report_login_status.IpAddress
  ,report_login_status.LoggedInAt
FROM
  report_login_status</CommandText>
      </Query>
      <Fields>
        <Field Name="Id">
          <rd:TypeName>System.Int64</rd:TypeName>
          <DataField>Id</DataField>
        </Field>
