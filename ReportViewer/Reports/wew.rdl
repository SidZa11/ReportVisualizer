  <DataSets>
    <DataSet Name="process_data">
      <Query>
        <DataSourceName>DataSource1</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@LT201">
            <Value>=Parameters!LT201.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
        <CommandText>SELECT
  ProcessData.Time_Stamp
  ,ProcessData.Time_Stamp_ms
  ,ProcessData.RO1_RO2_CONTROL_MODE
  ,ProcessData.PW_CONTROL_MODE
  ,ProcessData.PW_PROCESS_MODE__START_STOP
  ,ProcessData.RO1_RO2_EDI_SANIT_MODE
  ,ProcessData.pHC_101_PV
  ,ProcessData.CT_101_PV
  ,ProcessData.CT_102_PV
  ,ProcessData.CT_103_PV
  ,ProcessData.LT_201_PV
  ,ProcessData.TT_202_PV
  ,ProcessData.CT_201_PV
  ,ProcessData.TT_203_PV
  ,ProcessData.TOC_201_PV
  ,ProcessData.TT_201_PV
  ,ProcessData.ORP_101_PV
  ,ProcessData.RO_Process_Status
FROM
  ProcessData
WHERE LT_201_PV = @LT201;</CommandText>
      </Query>
