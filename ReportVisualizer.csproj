<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <NoWarn>NU1701</NoWarn>
    <OutputType>WinExe</OutputType>
    <DisableFastUpToDateCheck>true</DisableFastUpToDateCheck>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" Version="5.1.1" />

    <PackageReference Include="ReportViewerCore.NETCore" Version="15.1.26" />
    <PackageReference Include="System.Data.SqlClient" Version="4.8.5" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Razor.RuntimeCompilation" Version="9.0.0-preview.1.24081.5" />
    <PackageReference Include="System.Management" Version="10.0.3" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="DataAccessLayer\DatabaseConfig\" />
    <Folder Include="DataAccessLayer\Models\" />
    <Folder Include="ReportTemplates\PredefinedTemplates\" />
    <Folder Include="ReportTemplates\TemplateEditor\" />
    <Folder Include="ReportDevelopment\" />
    <Folder Include="ReportViewer\" />
    <Folder Include="Utilities\" />
    <Folder Include="App_Start\" />
    <Folder Include="Security\" />
    <Folder Include="logo\" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="logo\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <Target Name="PrepareAppIcon" BeforeTargets="BeforeBuild;CoreCompile">
    <MakeDir Directories="$(IntermediateOutputPath)" Condition="!Exists('$(IntermediateOutputPath)')" />
    <PropertyGroup>
      <_TargetIco>$(IntermediateOutputPath)app.ico</_TargetIco>
      <_CfgPath>$(MSBuildProjectDirectory)\appsettings.json</_CfgPath>
      <_LogoDir>$(MSBuildProjectDirectory)\logo</_LogoDir>
      <_ScriptPath>$(MSBuildProjectDirectory)\build\generate-app-icon.ps1</_ScriptPath>
    </PropertyGroup>

    <Exec Command="powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;$(_ScriptPath)&quot; -CfgPath &quot;$(_CfgPath)&quot; -LogoDir &quot;$(_LogoDir)&quot; -DstIcoPath &quot;$(_TargetIco)&quot;"
          Condition="Exists('$(_ScriptPath)')"
          ConsoleToMsBuild="true" ContinueOnError="true" />

    <PropertyGroup Condition="Exists('$(_TargetIco)')">
      <ApplicationIcon>$(_TargetIco)</ApplicationIcon>
    </PropertyGroup>

    <Message Importance="high" Text="Logo application icon: $(ApplicationIcon)" />
  </Target>

</Project>
