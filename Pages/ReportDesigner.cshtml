@page
@model ReportVisualizer.Pages.ReportDesignerModel
@{
    ViewData["Title"] = "Report Designer";
}

<h1>Report Designer</h1>
@Html.AntiForgeryToken()

<div class="row">
    <div class="col-md-6">
        <h2>Available Templates</h2>
        <select id="templateSelector" class="form-control">
            <option value="">-- Select a Template --</option>
            @foreach (var template in Model.AvailableTemplates)
            {
                <option value="@template" selected="@(template == Model.SelectedTemplate)">@template</option>
            }
        </select>
        <button id="loadTemplateBtn" class="btn btn-primary mt-2">Edit Template</button>
        <button id="createNewTemplateBtn" class="btn btn-success mt-2">Create New Template</button>
    </div>
</div>

<!-- New Template Modal -->
<div class="modal fade" id="newTemplateModal" tabindex="-1" aria-labelledby="newTemplateModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="newTemplateModalLabel">Create New Template</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label for="newTemplateNameInput" class="form-label">Template Name</label>
                    <input type="text" class="form-control" id="newTemplateNameInput" placeholder="Enter new template name">
                    <div class="invalid-feedback">
                        Template name cannot be empty.
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="saveNewTemplateButton">Open</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            // Set selected template if available in URL
            var urlParams = new URLSearchParams(window.location.search);
            var templateNameFromUrl = urlParams.get('templateName');
            if (templateNameFromUrl) {
                $('#templateSelector').val(templateNameFromUrl);
            }

            $('#loadTemplateBtn').click(function () {
                var selectedTemplate = $('#templateSelector').val();
                console.log("selected template name: "+ selectedTemplate)
                if (selectedTemplate) {
                    launchReportBuilderProcess(selectedTemplate);
                } else {
                    alert('Please select a template to edit.');
                }
            });

            $('#createNewTemplateBtn').on('click', function () {
                $('#newTemplateModal').modal('show');
            });

            $('#saveNewTemplateButton').on('click', function () {
                var newTemplateName = $('#newTemplateNameInput').val();
                if (!newTemplateName) {
                    $('#newTemplateNameInput').addClass('is-invalid');
                    return;
                } else {
                    $('#newTemplateNameInput').removeClass('is-invalid');
                }
                createNewTemplateAndLaunchBuilderProcess(newTemplateName);
            });

            $('#newTemplateModal').on('hidden.bs.modal', function () {
                $('#newTemplateNameInput').removeClass('is-invalid').val('');
            });

            function launchReportBuilderProcess(templateName) {
                $.ajax({
                    type: "POST",
                    url: "?handler=LaunchReportBuilder",
                    data: { templateName: templateName },
                    headers: {
                        "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val()
                    },
                    success: function (response) {
                        if (response.success) {
                            console.log(response.message);
                        } else {
                            alert("Error: " + response.message);
                        }
                    },
                    error: function (xhr, status, error) {
                        alert("AJAX Error: " + error);
                    }
                });
            }

            function createNewTemplateAndLaunchBuilderProcess(templateName) {
                $.ajax({
                    type: "POST",
                    url: "?handler=CreateNewTemplateAndLaunchBuilder",
                    data: { templateName: templateName },
                    headers: {
                        "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val()
                    },
                    success: function (response) {
                        if (response.success) {
                            console.log(response.message);
                            $('#newTemplateModal').modal('hide');
                        } else {
                            alert("Error: " + response.message);
                        }
                    },
                    error: function (xhr, status, error) {
                        alert("AJAX Error: " + error);
                    }
                });
            }
        });
    </script>
}