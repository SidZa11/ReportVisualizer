@page
@model ReportVisualizer.Pages.ReportViewerModel

@{
    ViewData["Title"] = "Report Viewer";
}
<link rel="stylesheet" href="../css/site.css" asp-append-version="true" />

<div class="container-fluid mt-3">
    <div class="row">

        <!-- LEFT PANEL -->
        <div class="col-md-3">
            <div class="card shadow-sm report-panel">
                <div class="card-header bg-light">
                    <h5 class="mb-0">Reports</h5>
                </div>

                <div class="card-body">
                    @if (Model.AvailableReports != null && Model.AvailableReports.Any())
                    {
                        <form method="get" id="reportSelectionForm">
                            <select name="reportName" class="form-control mb-3 h-50" id="reportSelect">
                                <option value="">-- Select a Report --</option>
                                @foreach (var report in Model.AvailableReports)
                                {
                                    <option value="@report" selected="@(report == Model.ReportName)">@report</option>
                                }
                            </select>

                            <div class="d-grid gap-2">
                                <button type="submit" class="btn btn-primary">View</button>
                                <button type="button" class="btn btn-warning" onclick="editReport()" id="editReportButton">Edit</button>
                            </div>
                        </form>
                    }
                    else
                    {
                        <p>No reports available.</p>
                    }
                </div>
            </div>
        </div>


        <!-- RIGHT PANEL -->
        <div class="col-md-9">
            <div class="card shadow-sm report-viewer">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <span>
                        @(string.IsNullOrEmpty(Model.ReportName) ? "Report Preview" : Model.ReportName)
                    </span>

                    <!-- Export Buttons -->
                    <div>
                        @if (Model.ShowExcelExport)
                        {
                            <button class="btn btn-sm btn-success" onclick="exportReport('excel')">Excel</button>
                        }
                        @if (Model.ShowPdfExport)
                        {
                            <button class="btn btn-sm btn-danger" onclick="exportReport('pdf')">PDF</button>
                        }
                        @if (Model.ShowPrint)
                        {
                            <button class="btn btn-sm btn-secondary" onclick="printReport()">Print</button>
                        }
                    </div>
                </div>

                <div class="card-body overflow-auto" id="reportContainer">
                    @if (Model.ShowParameterPopup)
                    {
                        <partial name="_ParameterInputPopup" model="Model" />
                    }
                    else if (!string.IsNullOrEmpty(Model.ReportHtmlContent))
                    {
                        <div>
                            @Html.Raw(Model.ReportHtmlContent)
                        </div>
                    }
                    else
                    {
                        <div class="text-muted text-center py-5">
                            Select a report and click <strong>View</strong> to preview.
                        </div>
                    }
                </div>
            </div>
        </div>

    </div>
</div>


@section Scripts {
    <script>
        function editReport() {
            var report = document.getElementById("reportSelect").value;

            if (!report) {
                alert("Please select a report first");
                return;
            }

            // Call backend to get local file path
            fetch(`/ReportViewer?handler=EditPath&reportName=` + encodeURIComponent(report))
                .then(r => r.text())
                .then(path => {
                    if (path.startsWith("ERROR")) {
                        alert(path);
                        return;
                    }

                    // Launch Report Builder
                    //window.location.href = "ms-rdl:ofe|u|" + path;
                });
        }

        function exportReport(type) {
            var report = document.getElementById("reportSelect").value;

            if (!report) {
                alert("Select report first");
                return;
            }

            window.open(`/ReportViewer?handler=Export&reportName=${report}&format=${type}`, "_blank");
        }

        function printReport() {
            var report = document.getElementById("reportSelect").value;

            if (!report) {
                alert("Select report first");
                return;
            }

            var printUrl = `/ReportViewer?handler=PrintPdf&reportName=${encodeURIComponent(report)}`;

            fetch(printUrl)
                .then(function (response) {
                    if (!response.ok) throw new Error("Server returned " + response.status);
                    return response.blob();
                })
                .then(function (blob) {
                    var blobUrl = URL.createObjectURL(blob);
                    var w = window.open('', '_blank', 'height=900,width=1200');
                    if (!w) {
                        window.open(printUrl, '_blank');
                        return;
                    }
                    w.document.write('<html><head><title>Print Report</title>');
                    w.document.write('<style>html,body{margin:0;padding:0;height:100%;width:100%;overflow:hidden;}</style>');
                    w.document.write('</head><body>');
                    w.document.write('<iframe id="pdfFrame" src="' + blobUrl + '" style="width:100vw;height:100vh;border:none;display:block;"></iframe>');
                    w.document.write('<scr' + 'ipt>');
                    w.document.write('(function(){var frame=document.getElementById("pdfFrame");function tryPrint(){try{frame.contentWindow.focus();frame.contentWindow.print();}catch(e){console.log("Auto-print not available. Please press Ctrl+P or use the PDF viewer print button.");}};if(frame.contentDocument && frame.contentDocument.readyState==="complete"){setTimeout(tryPrint,500);}else{frame.onload=function(){setTimeout(tryPrint,500);};}})();');
                    w.document.write('</scr' + 'ipt>');
                    w.document.write('</body></html>');
                    w.document.close();
                })
                .catch(function (err) {
                    console.error("Print via PDF failed:", err);
                    window.open(printUrl, '_blank');
                });
        }

        $(document).ready(function () {
            if (@Model.ShowParameterPopup.ToString().ToLower()) {
                $('#parameterInputPopup').modal({
                    backdrop: 'static', // Prevent closing by clicking outside
                    keyboard: false // Prevent closing by pressing escape key
                });
                $('#parameterInputPopup').modal('show');
            }

            // Hide Edit button if not in Dev Mode
            if (sessionStorage.getItem("mode") !== "DEV") {
                $("#editReportButton").hide();
            }
        });
    </script>
}
</div>