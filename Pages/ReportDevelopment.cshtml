@page
@model ReportVisualizer.Pages.ReportDevelopmentModel
@{
    ViewData["Title"] = "Create Reports";
}

<h1>Create Reports</h1>

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger" role="alert">
        @TempData["ErrorMessage"]
    </div>
}

<form method="post">
    @Html.AntiForgeryToken()
    <div class="form-group">
        <label for="SelectedTemplate">Select Report Template:</label>
        <select id="reportTemplateSelector" asp-for="SelectedTemplate" asp-items="new SelectList(Model.AvailableTemplates)" class="form-control"></select>
    <div class="form-group">
        <label for="ReportName">Report Name:</label>
        <input type="text" id="reportNameInput" name="ReportName" class="form-control" />
    </div>
    <button type="button" id="createReportButton" class="btn btn-primary">Create</button>
</form>

@section Scripts {
    @* @await Html.PartialAsync("_ReportNamePopup") *@

    <script>
        $(document).ready(function () {
            $('#editTemplateButton').on('click', function () {
                var reportName = $('#reportNameInput').val();
                var selectedTemplate = $('#reportTemplateSelector').val();

                if (!reportName) {
                    alert('Please enter a report name.');
                    return;
                }

                // Logic for "Edit Template"
                // This will open the selected template in the report builder
                window.location.href = '/ReportDesigner?templateName=' + encodeURIComponent(selectedTemplate);
            });

            $('#createReportButton').on('click', function () {
                var reportName = $('#reportNameInput').val();
                var selectedTemplate = $('#reportTemplateSelector').val();

                if (!reportName) {
                    alert('Please enter a report name.');
                    return;
                }

                // Function to create the report
                function createReport() {
                    $.ajax({
                        type: "POST",
                        url: "?handler=CreateReport",
                        beforeSend: function (xhr) {
                            xhr.setRequestHeader("RequestVerificationToken",
                                $('input:hidden[name="__RequestVerificationToken"]').val());
                        },
                        data: {
                            reportName: reportName,
                            templateName: selectedTemplate
                        },
                        success: function (response) {
                            if (response.success) {
                                window.location.href = response.redirectUrl;
                            } else {
                                alert(response.message);
                            }
                        },
                        error: function (xhr, status, error) {
                            console.error("AJAX Error: ", status, error, xhr);
                            alert("Error saving report: " + xhr.responseText);
                        }
                    });
                }

                // Check if report exists
                $.ajax({
                type: "GET",
                url: "?handler=CheckReportExists",
                data: { reportName: reportName },
                success: function (response) {

                    if (response.exists) {

                        if (confirm('A report with this name already exists. Do you want to edit it in Report Builder?')) {

                            // ---------- IMPORTANT PART ----------
                            // We must do a normal form POST instead of AJAX
                            // so Windows allows ReportBuilder GUI to open

                            let form = document.createElement("form");
                            form.method = "post";
                            form.action = "?handler=LaunchReportBuilder";

                            // reportName
                            let r = document.createElement("input");
                            r.type = "hidden";
                            r.name = "reportName";
                            r.value = reportName;
                            form.appendChild(r);

                            // templateName
                            let t = document.createElement("input");
                            t.type = "hidden";
                            t.name = "templateName";
                            t.value = selectedTemplate;
                            form.appendChild(t);

                            // antiforgery token
                            let token = document.querySelector('input[name="__RequestVerificationToken"]');
                            if (token) {
                                form.appendChild(token.cloneNode(true));
                            }

                            document.body.appendChild(form);
                            form.submit();

                            // DO NOT continue JS execution
                            return;
                        }
                    }
                    else {
                        createReport(); // create new report (your existing logic)
                    }
                },
                error: function (xhr, status, error) {
                    console.error("AJAX Error checking report existence: ", status, error, xhr);
                    alert("Error checking report existence.");
                }
            });

            });
        });
    </script>
}