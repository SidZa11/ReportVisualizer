@page
@model ReportVisualizer.Pages.DatabaseConfigPageModel
@{
    ViewData["Title"] = "Database Configuration";
}

<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header">
                Database Configuration
            </div>
            <div class="card-body">
                <p class="mb-4">Configure your database connection. You can test the connection before saving.</p>

                @if (Model.IsDbConnected)
                {
                    <div class="alert alert-success" role="alert">
                        Database is connected!
                    </div>
                }
                else
                {
                    <div class="alert alert-warning" role="alert">
                        Database is not connected. Please configure and test.
                    </div>
                }

                @if (!string.IsNullOrEmpty(Model.Message))
                {
                    <div class="alert alert-info" role="alert">@Model.Message</div>
                }
                @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                {
                    <div class="alert alert-danger" role="alert">@Model.ErrorMessage</div>
                }

                <form method="post">
                    <div class="row">
                        <div class="col-md-6 col-12 mb-3">
                            <label for="ServerName">Server</label>
                            <input asp-for="Config.ServerName" class="form-control" />
                        </div>
                        <div class="col-md-6 col-12 mb-3">
                            <label for="DatabaseName">Database</label>
                            <input asp-for="Config.DatabaseName" class="form-control" />
                        </div>
                        <div class="col-md-6 col-12 mb-3">
                            <label class="checkbox">
                                <input asp-for="Config.UseIntegratedSecurity" /> Use Integrated Security (Windows Auth)
                            </label>
                        </div>
                        <div class="col-md-6 col-12 mb-3">
                            <label class="checkbox">
                                <input asp-for="Config.TrustServerCertificate" /> Trust Server Certificate
                            </label>
                        </div>
                        <div class="col-md-6 col-12 mb-3">
                            <label for="ConnectionTimeout">Connection Timeout (seconds)</label>
                            <input asp-for="Config.ConnectionTimeout" class="form-control" type="number" min="1" />
                        </div>

                        @if (!Model.Config.UseIntegratedSecurity)
                        {
                            <div class="col-md-6 col-12 mb-3">
                                <label for="Username">Username</label>
                                <input asp-for="Config.Username" class="form-control" />
                            </div>
                            <div class="col-md-6 col-12 mb-3">
                                <label for="Password">Password</label>
                                <input asp-for="Config.Password" class="form-control" type="password" />
                            </div>
                        }
                    </div>

                    <div class="d-flex justify-content-end mt-4">
                        <button type="submit" asp-page-handler="Test" class="btn btn-primary me-2">Test Connection</button>
                        <button type="submit" asp-page-handler="Save" class="btn btn-success">Save Configuration</button>
                    </div>
                </form>

                <div class="mt-5 p-3 bg-light rounded shadow-sm">
                    <h5 class="text-primary">Generated Connection String</h5>
                    <code class="d-block text-break">@Model.GeneratedConnectionString</code>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row mt-4">
    <div class="col-12">
        <div class="card">
            <div class="card-header">
                Table Configuration
            </div>
            <div class="card-body">
                <p>Configure tables and columns for specific operations.</p>
                <button type="button" class="btn btn-info" data-toggle="modal" data-target="#tableConfigModal">
                    Open Table Config
                </button>
            </div>
        </div>
    </div>
</div>





<!-- Table Config Modal -->
<div class="modal fade" id="tableConfigModal" tabindex="-1" aria-labelledby="tableConfigModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="tableConfigModalLabel">Table Configuration</h5>
                <button type="button" class="btn-close" data-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label for="tableSelect" class="form-label">Select Table:</label>
                    <select class="form-select" id="tableSelect">
                        <option value="">-- Select a Table --</option>
                    </select>
                </div>
                <div class="mb-3">
                    <label for="dateTimeColumnSelect" class="form-label">Select Time Column:</label>
                    <select class="form-select" id="dateTimeColumnSelect">
                        <option value="">-- Select a Time Column --</option>
                    </select>
                </div>
                <div class="mb-3">
                    <label class="form-label">Select Columns:</label>
                    <div id="columnCheckboxes" class="border p-3" style="max-height: 200px; overflow-y: auto;">
                        <!-- Columns will be loaded here dynamically -->
                        <p>Select a table to load columns.</p>
                    </div>
                </div>

            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
                <button type="button" class="btn btn-primary" id="runQueryButton">Run Query</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/databaseConfig.js"></script>
}