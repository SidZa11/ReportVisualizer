@page
@model ReportVisualizer.Pages.LoginModel
@{
    ViewData["Title"] = "Login";
    Layout = null;
    var returnUrl = ViewData["ReturnUrl"]?.ToString();
    bool showClientLogo = Model?.ClientLogo?.HasLogo == true;
    string clientLogoUrl = showClientLogo ? Model.ClientLogo.RelativeUrl : null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login - Report Visualizer</title>
    <link rel="stylesheet" href="~/css/site.css" />
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css">
    <style>
        html, body {
            height: 100%;
        }
        body {
            background: linear-gradient(135deg, #0f2027 0%, #203a43 50%, #2c5364 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 1rem;
        }
        .login-card {
            background: #ffffffee;
            backdrop-filter: blur(12px);
            border-radius: 16px;
            box-shadow: 0 20px 50px rgba(0,0,0,0.35);
            width: 100%;
            max-width: 440px;
            overflow: hidden;
            display: flex;
            flex-direction: column;
        }
        .login-header {
            background: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%);
            color: #fff;
            padding: 1.75rem 1.5rem;
            text-align: center;
        }
        .login-header h1 {
            margin: 0;
            font-size: 1.6rem;
            letter-spacing: 0.3px;
        }
        .login-header p {
            margin: 0.35rem 0 0;
            opacity: 0.9;
            font-size: 0.95rem;
        }
        .login-body {
            padding: 1.75rem 1.5rem 1.5rem;
            flex: 1;
        }
        .login-brand {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            padding: 0.25rem 0.65rem;
            border-radius: 999px;
            background: rgba(30, 60, 114, 0.08);
            color: #1e3c72;
            font-weight: 600;
            font-size: 0.8rem;
            margin-bottom: 1rem;
        }
        .btn-primary {
            background: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%);
            border: none;
            box-shadow: 0 6px 18px rgba(42, 82, 152, 0.45);
        }
        .btn-primary:hover {
            opacity: 0.95;
            transform: translateY(-1px);
        }
        .form-control:focus {
            box-shadow: 0 0 0 3px rgba(42, 82, 152, 0.2);
            border-color: #2a5298;
        }
        .login-footer {
            padding: 0.75rem 1.5rem 1.1rem;
            text-align: center;
            background: rgba(255,255,255,0.55);
            border-top: 1px solid rgba(30, 60, 114, 0.08);
        }
        .client-logo-wrap {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 0.5rem;
            opacity: 0.55;
            filter: grayscale(45%);
            transition: opacity 0.2s ease, filter 0.2s ease, transform 0.2s ease;
        }
        .client-logo-wrap:hover {
            opacity: 0.9;
            filter: grayscale(0%);
            transform: translateY(-1px);
        }
        .client-logo-wrap img {
            max-height: 32px;
            max-width: 160px;
            object-fit: contain;
        }
        .client-logo-caption {
            font-size: 0.72rem;
            letter-spacing: 0.3px;
            color: #5c6b83;
            font-weight: 500;
        }
    </style>
</head>
<body>
    <div class="login-card">
        <div class="login-header">
            <h1>Report Visualizer</h1>
            <p>Sign in to view reports</p>
        </div>
        <div class="login-body">
            <div class="login-brand">SCADA LOGIN</div>

            @if (!string.IsNullOrEmpty(Model.ErrorMessage))
            {
                <div class="alert alert-danger" role="alert">
                    @Model.ErrorMessage
                </div>
            }

            <form method="post" asp-page-handler="" asp-route-returnUrl="@returnUrl">
                <div class="form-group mb-3">
                    <label for="Username" class="font-weight-semibold">Username</label>
                    <input type="text" id="Username" asp-for="Username" class="form-control" autocomplete="username" autofocus required />
                </div>
                <div class="form-group mb-4">
                    <label for="Password" class="font-weight-semibold">Password</label>
                    <input type="password" id="Password" asp-for="Password" class="form-control" autocomplete="current-password" required />
                </div>
                <button type="submit" class="btn btn-primary btn-block py-2 font-weight-semibold">Sign in</button>
            </form>
        </div>
        @if (showClientLogo)
        {
            <div class="login-footer">
                <div class="client-logo-wrap">
                    <img src="@clientLogoUrl" alt="logo" />
                    <span class="client-logo-caption">Powered By</span>
                </div>
            </div>
        }
    </div>

    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.5.1/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/popper.js/1.16.0/umd/popper.min.js"></script>
    <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script>
</body>
</html>
